<% content_for :title, "Inicio" %>
<div class="max-w-6xl mx-auto px-4 py-6">
  <h1 class="text-xl font-bold text-gray-800 mb-6">👋 Hola, <%= current_user.nombre.split.first %></h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% if permisos["verForecast"] %>
      <% if current_user.admin? %>
        <% pct = @total_kams.zero? ? 0 : (@gmv_diligenciado_count.to_f / @total_kams) %>
        <%= link_to forecast_entries_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
            <span class="dash-icon">📈</span>
            <h3 class="dash-title">Forecast</h3>
            <p class="dash-stat"><%= @gmv_diligenciado_count %> / <%= @total_kams %> KAM con GMV diligenciado</p>
            <div class="dash-progress"><div class="dash-progress-fill" style="width: <%= (pct * 100).round %>%;"></div></div>
          </div>
        <% end %>
      <% else %>
        <%= link_to forecast_entries_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
            <span class="dash-icon">📈</span>
            <h3 class="dash-title">Forecast</h3>
            <% if @mi_one_on_one && @mi_one_on_one.gmv_real.to_f > 0 %>
              <p class="dash-stat">Cumplimiento: <%= fmt_pct(@mi_one_on_one.cumplimiento_gmv) %></p>
              <div class="dash-progress"><div class="dash-progress-fill" style="width: <%= [ (@mi_one_on_one.cumplimiento_gmv.to_f * 100).round, 100 ].min %>%;"></div></div>
            <% else %>
              <p class="dash-stat">Todavía no diligencias este mes</p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if permisos["gestionarMetas"] %>
      <% pct = @total_kams.zero? ? 0 : (@goals_count.to_f / @total_kams) %>
      <%= link_to goals_path, class: "dash-card" do %>
        <div class="dash-card-inner" style="background: linear-gradient(135deg, #059669, #10b981);">
          <span class="dash-icon">🎯</span>
          <h3 class="dash-title">Asignación de Metas</h3>
          <p class="dash-stat"><%= @goals_count %> / <%= @total_kams %> KAM con meta asignada</p>
          <div class="dash-progress"><div class="dash-progress-fill" style="width: <%= (pct * 100).round %>%;"></div></div>
        </div>
      <% end %>
    <% end %>

    <% if permisos["ver1a1"] %>
      <% if current_user.admin? %>
        <% pct = @total_kams.zero? ? 0 : (@one_on_ones_count.to_f / @total_kams) %>
        <%= link_to one_on_ones_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #7c3aed, #a78bfa);">
            <span class="dash-icon">🧑‍💼</span>
            <h3 class="dash-title">1:1 KAM</h3>
            <p class="dash-stat"><%= @one_on_ones_count %> / <%= @total_kams %> KAM con 1:1 diligenciado</p>
            <div class="dash-progress"><div class="dash-progress-fill" style="width: <%= (pct * 100).round %>%;"></div></div>
          </div>
        <% end %>
      <% else %>
        <%= link_to one_on_ones_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #7c3aed, #a78bfa);">
            <span class="dash-icon">🧑‍💼</span>
            <h3 class="dash-title">1:1 KAM</h3>
            <p class="dash-stat"><%= @mi_one_on_one ? "✓ Diligenciado este mes" : "Pendiente este mes" %></p>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if permisos["verClientes"] %>
      <% if current_user.admin? %>
        <% pct = @total_kams.zero? ? 0 : (@kams_con_clientes_count.to_f / @total_kams) %>
        <%= link_to clientes_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #0d9488, #2dd4bf);">
            <span class="dash-icon">🤝</span>
            <h3 class="dash-title">Clientes</h3>
            <p class="dash-stat"><%= @kams_con_clientes_count %> / <%= @total_kams %> KAM con archivo cargado</p>
            <div class="dash-progress"><div class="dash-progress-fill" style="width: <%= (pct * 100).round %>%;"></div></div>
          </div>
        <% end %>
      <% else %>
        <%= link_to clientes_path, class: "dash-card" do %>
          <div class="dash-card-inner" style="background: linear-gradient(135deg, #0d9488, #2dd4bf);">
            <span class="dash-icon">🤝</span>
            <h3 class="dash-title">Clientes</h3>
            <p class="dash-stat"><%= @mi_archivo_clientes ? "✓ Archivo cargado este mes" : "Pendiente este mes" %></p>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if current_user.admin? %>
      <%= link_to users_path, class: "dash-card" do %>
        <div class="dash-card-inner" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
          <span class="dash-icon">👥</span>
          <h3 class="dash-title">Usuarios</h3>
          <p class="dash-stat"><%= @usuarios_activos %> usuarios activos</p>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if current_user.admin? %>
    <div class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-gray-800">📊 Resumen anual — Todo el equipo</h2>
        <%= link_to "Ver evolución por KAM →", evolucion_one_on_ones_path, class: "text-xs text-purple-600 hover:underline" %>
      </div>

      <%= form_with url: root_path, method: :get, class: "flex items-end gap-3 mb-4" do %>
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">Mes</label>
          <select name="evo_month" onchange="this.form.requestSubmit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
            <option value="" <%= "selected" if @evo_month.blank? %>>Todos los meses</option>
            <% (1..12).each do |m| %>
              <option value="<%= m %>" <%= "selected" if @evo_month == m.to_s %>><%= mes_nombre(m) %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">Año</label>
          <input type="number" name="evo_year" value="<%= @evo_year %>" class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-28">
        </div>
        <button type="submit" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium">Ver</button>
      <% end %>

      <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4 mb-4">
        <p class="text-xs text-gray-400 mb-3">
          <%= @evo_month.present? ? "#{mes_nombre(@evo_month)} #{@evo_year}" : "Acumulado #{@evo_year}" %> · suma de <%= @total_kams %> KAM
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Meta GMV</p>
            <p class="text-lg font-bold text-gray-800"><%= fmt(@evo_resumen[:meta_gmv]) %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">GMV real</p>
            <p class="text-lg font-bold text-gray-800"><%= fmt(@evo_resumen[:gmv_real]) %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Cumplimiento</p>
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:cumplimiento_gmv]) %>"><%= fmt_pct(@evo_resumen[:cumplimiento_gmv]) %></span>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">OKR Gestión</p>
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:okr_gestion]) %>"><%= fmt_pct(@evo_resumen[:okr_gestion]) %></span>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">OKR Asistencia</p>
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:okr_asistencia]) %>"><%= fmt_pct(@evo_resumen[:okr_asistencia]) %></span>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Prospección</p>
            <p class="text-lg font-bold text-gray-800"><%= @evo_resumen[:prospeccion].to_i %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Reuniones</p>
            <p class="text-lg font-bold text-gray-800"><%= @evo_resumen[:reuniones].to_i %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Pipeline $</p>
            <p class="text-lg font-bold text-gray-800"><%= fmt(@evo_resumen[:pipeline_valor]) %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Cierres #</p>
            <p class="text-lg font-bold text-gray-800"><%= @evo_resumen[:cierres_count] %></p>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-semibold mb-1">Cierres $</p>
            <p class="text-lg font-bold text-gray-800"><%= fmt(@evo_resumen[:cierres_gmv]) %></p>
          </div>
        </div>
      </div>

      <% if @evo_month.blank? %>
        <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
              <tr>
                <th class="text-left px-3 py-2">Mes</th>
                <th class="text-right px-3 py-2">Meta GMV</th>
                <th class="text-right px-3 py-2">GMV real</th>
                <th class="text-right px-3 py-2">Cumplimiento</th>
                <th class="text-right px-3 py-2">OKR Gestión</th>
                <th class="text-right px-3 py-2">OKR Asistencia</th>
                <th class="text-right px-3 py-2">Prospección</th>
                <th class="text-right px-3 py-2">Reuniones</th>
                <th class="text-right px-3 py-2">Pipeline $</th>
                <th class="text-right px-3 py-2">Cierres #</th>
                <th class="text-right px-3 py-2">Cierres $</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @evo_meses.each do |m| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2 font-medium text-gray-800"><%= mes_nombre(m[:mes]) %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= fmt(m[:meta_gmv]) %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= fmt(m[:gmv_real]) %></td>
                  <td class="px-3 py-2 text-right">
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(m[:cumplimiento_gmv]) %>"><%= fmt_pct(m[:cumplimiento_gmv]) %></span>
                  </td>
                  <td class="px-3 py-2 text-right">
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(m[:okr_gestion]) %>"><%= fmt_pct(m[:okr_gestion]) %></span>
                  </td>
                  <td class="px-3 py-2 text-right">
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(m[:okr_asistencia]) %>"><%= fmt_pct(m[:okr_asistencia]) %></span>
                  </td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= m[:prospeccion].to_i %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= m[:reuniones].to_i %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= fmt(m[:pipeline_valor]) %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= m[:cierres_count].to_i %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= fmt(m[:cierres_gmv]) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="bg-gray-50 font-semibold">
                <td class="px-3 py-2">Total <%= @evo_year %></td>
                <td class="px-3 py-2 text-right"><%= fmt(@evo_resumen[:meta_gmv]) %></td>
                <td class="px-3 py-2 text-right"><%= fmt(@evo_resumen[:gmv_real]) %></td>
                <td class="px-3 py-2 text-right">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:cumplimiento_gmv]) %>"><%= fmt_pct(@evo_resumen[:cumplimiento_gmv]) %></span>
                </td>
                <td class="px-3 py-2 text-right">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:okr_gestion]) %>" title="Promedio de los meses diligenciados"><%= fmt_pct(@evo_resumen[:okr_gestion]) %></span>
                </td>
                <td class="px-3 py-2 text-right">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@evo_resumen[:okr_asistencia]) %>" title="Promedio de los meses diligenciados"><%= fmt_pct(@evo_resumen[:okr_asistencia]) %></span>
                </td>
                <td class="px-3 py-2 text-right"><%= @evo_resumen[:prospeccion].to_i %></td>
                <td class="px-3 py-2 text-right"><%= @evo_resumen[:reuniones].to_i %></td>
                <td class="px-3 py-2 text-right"><%= fmt(@evo_resumen[:pipeline_valor]) %></td>
                <td class="px-3 py-2 text-right"><%= @evo_resumen[:cierres_count] %></td>
                <td class="px-3 py-2 text-right"><%= fmt(@evo_resumen[:cierres_gmv]) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  .dash-card { display: block; border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 14px rgba(0,0,0,0.08); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .dash-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.14); }
  .dash-card-inner { padding: 1.5rem; color: #ffffff; min-height: 150px; display: flex; flex-direction: column; }
  .dash-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .dash-title { font-weight: 700; font-size: 1.125rem; margin-bottom: auto; padding-bottom: 0.75rem; }
  .dash-stat { font-size: 0.8rem; color: rgba(255,255,255,0.9); margin-bottom: 0.5rem; }
  .dash-progress { height: 6px; border-radius: 999px; background: rgba(255,255,255,0.3); overflow: hidden; }
  .dash-progress-fill { height: 100%; background: #ffffff; border-radius: 999px; }
</style>
