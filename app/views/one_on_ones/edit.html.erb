<% content_for :title, "1:1 — #{@entry.user.nombre}" %>
<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-800">🧑‍💼 1:1 — <%= @entry.user.nombre %> · <%= mes_nombre(@entry.month) %> <%= @entry.year %></h1>
    <%= link_to "← Historial", one_on_ones_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>

  <%= form_with model: @entry, url: one_on_one_path(@entry), method: :patch, class: "space-y-6", id: "oo-form" do |f| %>
    <% if @entry.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 text-sm">
        <p class="font-semibold mb-2">Por favor corrige los siguientes errores:</p>
        <ul class="list-disc list-inside space-y-1">
          <% @entry.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <input type="hidden" name="one_on_one_entry[data]" id="data-json-input">

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-sm font-semibold text-gray-700">📈 Ventas</h4>
        <% if @entry.goal %>
          <span id="gmv-cumplimiento-badge" class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(@entry.cumplimiento_gmv) %>">Cumplimiento: <%= fmt_pct(@entry.cumplimiento_gmv) %></span>
        <% end %>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">GMV real *</label>
          <%= f.number_field :gmv_real, step: "1", id: "gmv-real-input", data: { meta: @entry.goal&.gmv_meta.to_f }, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
        </div>
        <div class="flex items-end">
          <% if @entry.goal %>
            <p class="text-xs text-gray-500 pb-2">Meta GMV: <strong class="text-gray-700"><%= fmt(@entry.goal.gmv_meta) %></strong></p>
          <% else %>
            <p class="text-xs text-purple-500 pb-2">No hay meta asignada para este mes todavía.</p>
          <% end %>
        </div>
      </div>
    </div>

    <% if @entry.goal.nil? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-3 text-xs text-yellow-700">
        No hay meta asignada para este mes todavía, así que no se pueden diligenciar los OKR.
      </div>
    <% else %>
      <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
        <%= render "realizado_table", field_name: "okr_gestion_real", goal: @entry.goal, tipo: :gestion, realizados: @entry.okr_gestion_real, titulo: "🎯 OKR Gestión — realizado" %>
      </div>
      <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
        <%= render "realizado_table", field_name: "okr_asistencia_real", goal: @entry.goal, tipo: :asistencia, realizados: @entry.okr_asistencia_real, titulo: "📋 OKR Asistencia — realizado" %>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "scalar_group", field_name: "prospeccion", titulo: "🔍 Prospección",
          values: @entry.seccion(:prospeccion),
          fields: [ { key: "propios", label: "Prospectos propios" }, { key: "referidos", label: "Prospectos referidos" }, { key: "mkt", label: "Prospectos MKT" } ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "scalar_group", field_name: "reuniones", titulo: "🤝 Reuniones / Visitas",
          values: @entry.seccion(:reuniones),
          fields: [ { key: "cantidad", label: "# Reuniones" } ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "scalar_group", field_name: "pipeline", titulo: "📈 Pipeline de Ventas",
          values: @entry.seccion(:pipeline),
          fields: [
            { key: "negocios_mkt", label: "# Negocios MKT" }, { key: "valor_mkt", label: "$ Negocios MKT" },
            { key: "negocios_referidos", label: "# Referidos" }, { key: "valor_referidos", label: "$ Referidos" },
            { key: "negocios_propios", label: "# Propios" }, { key: "valor_propios", label: "$ Propios" }
          ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "dynamic_rows", field_name: "cierres", titulo: "🏁 Cierres / Ventas Concretadas",
          items: @entry.seccion(:cierres),
          columns: [ { key: "cliente", label: "Cliente" }, { key: "gmv", label: "GMV", type: "number" } ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "dynamic_rows", field_name: "clientes_gestion", titulo: "🔁 Clientes en Gestión / Retención",
          items: @entry.seccion(:clientes_gestion),
          columns: [ { key: "cliente", label: "Cliente" }, { key: "motivo", label: "Motivo" }, { key: "gmv", label: "GMV", type: "number" } ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "dynamic_rows", field_name: "alertas", titulo: "⚠️ Alertas / Necesidades de Dirección",
          items: @entry.seccion(:alertas),
          columns: [ { key: "area", label: "Área" }, { key: "cliente", label: "Cliente" }, { key: "tema", label: "Tema" } ] %>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4">
      <%= render "dynamic_rows", field_name: "plan_accion", titulo: "🔄 Plan de Acción",
          items: @entry.seccion(:plan_accion),
          columns: [ { key: "tema", label: "Tema" }, { key: "compromiso", label: "Compromiso" } ] %>
    </div>

    <div class="bg-purple-50 border border-purple-100 rounded-xl p-4">
      <h3 class="text-sm font-semibold text-purple-800 mb-3">✨ Insights de gestión del mes</h3>
      <div class="space-y-3">
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">Puntos fuertes</label>
          <%= f.text_area :puntos_fuertes, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">Puntos de mejora</label>
          <%= f.text_area :puntos_mejora, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-600 mb-1 block">Notas</label>
          <%= f.text_area :notas, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
        </div>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Guardar 1:1", class: "px-6 py-2 text-white rounded-lg text-sm font-semibold cursor-pointer hover:opacity-90", style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
      <%= link_to "Cancelar", one_on_ones_path, class: "px-6 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" %>
    </div>
  <% end %>
</div>

<script>
(function () {
  function fmtPct(value) {
    if (value === null || !isFinite(value)) return "—";
    return (value * 100).toFixed(1) + "%";
  }

  function pctBadgeClasses(value) {
    if (value === null || !isFinite(value)) return [ "bg-gray-100", "text-gray-500" ];
    if (value >= 1) return [ "bg-green-100", "text-green-700" ];
    if (value >= 0.8) return [ "bg-yellow-100", "text-yellow-700" ];
    return [ "bg-red-100", "text-red-700" ];
  }

  function applyBadge(el, value, prefix) {
    el.classList.remove("bg-gray-100", "text-gray-500", "bg-green-100", "text-green-700", "bg-yellow-100", "text-yellow-700", "bg-red-100", "text-red-700");
    pctBadgeClasses(value).forEach(function (c) { el.classList.add(c); });
    el.textContent = (prefix || "") + fmtPct(value);
  }

  function updateGmvCumplimiento() {
    var input = document.getElementById("gmv-real-input");
    var badge = document.getElementById("gmv-cumplimiento-badge");
    if (!input || !badge) return;
    var meta = parseFloat(input.dataset.meta || "0");
    var real = parseFloat(input.value || "0");
    var cumplimiento = meta > 0 ? real / meta : null;
    applyBadge(badge, cumplimiento, "Cumplimiento: ");
  }

  var gmvInput = document.getElementById("gmv-real-input");
  if (gmvInput) gmvInput.addEventListener("input", updateGmvCumplimiento);

  document.querySelectorAll(".realizado-editor").forEach(function (editor) {
    function updateRow(row) {
      var meta = parseFloat(row.dataset.meta || "0");
      var input = row.querySelector(".realizado-valor");
      var real = parseFloat(input.value || "");
      var cumplimiento = (meta > 0 && input.value !== "") ? real / meta : null;
      applyBadge(row.querySelector(".cumplimiento-valor"), cumplimiento, "");
    }

    function updateTotal() {
      var total = 0;
      editor.querySelectorAll(".realizado-row").forEach(function (row) {
        var meta = parseFloat(row.dataset.meta || "0");
        var participacion = parseFloat(row.dataset.participacion || "0");
        var input = row.querySelector(".realizado-valor");
        var real = parseFloat(input.value || "0");
        var cumplimiento = (meta > 0 && input.value !== "") ? real / meta : 0;
        total += cumplimiento * participacion;
      });
      applyBadge(editor.querySelector(".total-cumplimiento"), total, "Total: ");
    }

    editor.querySelectorAll(".realizado-row").forEach(function (row) {
      row.querySelector(".realizado-valor").addEventListener("input", function () {
        updateRow(row);
        updateTotal();
      });
    });
  });

  document.querySelectorAll(".dyn-editor").forEach(function (editor) {
    var rowsContainer = editor.querySelector(".dyn-rows");
    editor.querySelector(".dyn-add-row").addEventListener("click", function () {
      var template = rowsContainer.querySelector(".dyn-row");
      var clone = template.cloneNode(true);
      clone.querySelectorAll("input").forEach(function (input) { input.value = ""; });
      rowsContainer.appendChild(clone);
    });
    rowsContainer.addEventListener("click", function (e) {
      if (e.target.classList.contains("dyn-remove-row")) {
        if (rowsContainer.querySelectorAll(".dyn-row").length > 1) {
          e.target.closest(".dyn-row").remove();
        }
      }
    });
  });

  function buildData() {
    var data = {};

    document.querySelectorAll(".scalar-editor").forEach(function (editor) {
      var obj = {};
      editor.querySelectorAll(".scalar-field").forEach(function (input) {
        if (input.value !== "") obj[input.dataset.key] = parseFloat(input.value);
      });
      data[editor.dataset.field] = obj;
    });

    document.querySelectorAll(".dyn-editor").forEach(function (editor) {
      var rows = [];
      editor.querySelectorAll(".dyn-row").forEach(function (row) {
        var obj = {};
        var hasValue = false;
        row.querySelectorAll(".dyn-field").forEach(function (input) {
          if (input.value !== "") {
            hasValue = true;
            obj[input.dataset.key] = input.type === "number" ? parseFloat(input.value) : input.value;
          }
        });
        if (hasValue) rows.push(obj);
      });
      data[editor.dataset.field] = rows;
    });

    return data;
  }

  function serializeRealizado(editor) {
    var items = [];
    editor.querySelectorAll(".realizado-valor").forEach(function (input) {
      if (input.value !== "") items.push({ nombre: input.dataset.nombre, realizado: parseFloat(input.value) });
    });
    editor.querySelector(".realizado-json-input").value = JSON.stringify(items);
  }

  var form = document.getElementById("oo-form");
  if (form) {
    form.addEventListener("submit", function () {
      document.getElementById("data-json-input").value = JSON.stringify(buildData());
      document.querySelectorAll(".realizado-editor").forEach(serializeRealizado);
    });
  }
})();
</script>
