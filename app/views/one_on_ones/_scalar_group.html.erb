<%# Locals: field_name (String), fields (Array de {key:, label:}), values (Hash), titulo %>
<div class="scalar-editor" data-field="<%= field_name %>">
  <h4 class="text-sm font-semibold text-gray-700 mb-2"><%= titulo %></h4>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
    <% fields.each do |f| %>
      <div>
        <label class="text-xs text-gray-500 mb-1 block"><%= f[:label] %></label>
        <input type="number" step="0.01" class="w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm scalar-field"
          data-key="<%= f[:key] %>" value="<%= (values || {})[f[:key].to_s] %>">
      </div>
    <% end %>
  </div>
</div>
