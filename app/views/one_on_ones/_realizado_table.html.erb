<%# Locals: field_name (String), goal (Goal), tipo (:gestion o :asistencia), realizados (Array de hashes ya guardados), titulo %>
<% rows = goal.okr_rows(tipo, realizados) %>
<% return if rows.blank? %>
<% total = goal.total_ponderado(tipo, realizados) %>
<div class="realizado-editor" data-field="<%= field_name %>">
  <div class="flex items-center justify-between mb-2">
    <h4 class="text-sm font-semibold text-gray-700"><%= titulo %></h4>
    <span class="px-2 py-0.5 rounded-full text-xs font-semibold total-cumplimiento <%= pct_badge_class(total) %>">Total: <%= fmt_pct(total) %></span>
  </div>
  <div class="grid grid-cols-12 gap-2 text-xs font-semibold text-gray-500 mb-1 px-1">
    <div class="col-span-4">OKR</div>
    <div class="col-span-2">Meta</div>
    <div class="col-span-2">Realizado</div>
    <div class="col-span-2">Cumplimiento</div>
    <div class="col-span-2">Participación</div>
  </div>
  <div class="space-y-1">
    <% rows.each do |row| %>
      <div class="grid grid-cols-12 gap-2 items-center realizado-row"
           data-meta="<%= row[:meta].to_f %>" data-participacion="<%= row[:participacion] %>">
        <div class="col-span-4 text-sm text-gray-700 px-2"><%= row[:nombre] %></div>
        <div class="col-span-2 text-sm text-gray-500 px-2"><%= fmt_meta(row[:meta], row[:unidad]) %></div>
        <input type="number" step="0.01"
          class="col-span-2 border border-gray-300 rounded-lg px-2 py-1.5 text-sm realizado-valor"
          data-nombre="<%= row[:nombre] %>"
          value="<%= row[:realizado] %>">
        <div class="col-span-2">
          <span class="px-2 py-0.5 rounded-full text-xs font-semibold cumplimiento-valor <%= pct_badge_class(row[:cumplimiento]) %>"><%= fmt_pct(row[:cumplimiento]) %></span>
        </div>
        <div class="col-span-2 text-sm text-gray-500 px-2"><%= fmt_pct(row[:participacion]) %></div>
      </div>
    <% end %>
  </div>
  <input type="hidden" name="one_on_one_entry[<%= field_name %>]" class="realizado-json-input">
</div>
