<%# Locals: field_name (String), meta_items (Array de hashes del Goal), realizados (Array de hashes ya guardados), titulo %>
<% return if meta_items.blank? %>
<% realizados_por_nombre = (realizados || []).index_by { |r| r["nombre"] } %>
<div class="realizado-editor" data-field="<%= field_name %>">
  <h4 class="text-sm font-semibold text-gray-700 mb-2"><%= titulo %></h4>
  <div class="grid grid-cols-12 gap-2 text-xs font-semibold text-gray-500 mb-1 px-1">
    <div class="col-span-6">OKR</div>
    <div class="col-span-3">Meta</div>
    <div class="col-span-3">Realizado</div>
  </div>
  <div class="space-y-1">
    <% meta_items.each do |item| %>
      <div class="grid grid-cols-12 gap-2 items-center realizado-row">
        <div class="col-span-6 text-sm text-gray-700 px-2"><%= item["nombre"] %></div>
        <div class="col-span-3 text-sm text-gray-500 px-2"><%= fmt_meta(item["meta"], item["unidad"]) %></div>
        <input type="number" step="0.01"
          class="col-span-3 border border-gray-300 rounded-lg px-2 py-1.5 text-sm realizado-valor"
          data-nombre="<%= item["nombre"] %>"
          value="<%= realizados_por_nombre[item["nombre"]]&.dig("realizado") %>">
      </div>
    <% end %>
  </div>
  <input type="hidden" name="one_on_one_entry[<%= field_name %>]" class="realizado-json-input">
</div>
