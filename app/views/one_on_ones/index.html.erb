<% content_for :title, "1:1 KAM" %>
<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-800">🧑‍💼 1:1 KAM</h1>
    <%= link_to "📊 Evolución anual", evolucion_one_on_ones_path, class: "text-sm text-purple-600 hover:underline font-medium" %>
  </div>

  <% if current_user.admin? %>
    <div class="space-y-4">
      <% @kams.each do |kam| %>
        <% color = kam_color(kam) %>
        <div class="bg-white shadow-sm rounded-xl border border-gray-100 border-l-4 <%= color[:border] %> p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-gray-800 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full <%= color[:dot] %> text-white text-xs font-bold flex items-center justify-center shrink-0"><%= kam.initial %></span>
              <%= kam.nombre %>
            </h3>
            <%= link_to "+ Ir al mes actual", entrar_one_on_ones_path(user_id: kam.id, year: Date.current.year, month: Date.current.month), class: "text-xs #{color[:text]} hover:underline" %>
          </div>
          <% entries = (@entries_by_kam[kam.id] || []).sort_by { |e| [ -e.year, -e.month ] } %>
          <% if entries.empty? %>
            <p class="text-xs text-gray-400">Sin registros todavía.</p>
          <% else %>
            <div class="flex flex-wrap gap-2">
              <% entries.each do |entry| %>
                <%= link_to "#{mes_nombre(entry.month)} #{entry.year}", edit_one_on_one_path(entry), class: "text-xs px-2 py-1 bg-gray-100 hover:bg-purple-100 text-gray-600 rounded-lg" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex justify-end mb-4">
      <%= link_to "+ Ir al mes actual", entrar_one_on_ones_path(year: Date.current.year, month: Date.current.month), class: "px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90", style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
    </div>
    <% if @entries.empty? %>
      <div class="bg-white rounded-xl border border-gray-100 p-10 text-center text-gray-400 text-sm">
        Todavía no tienes registros de 1:1.
      </div>
    <% else %>
      <div class="flex flex-wrap gap-2">
        <% @entries.each do |entry| %>
          <%= link_to "#{mes_nombre(entry.month)} #{entry.year}", edit_one_on_one_path(entry), class: "text-sm px-3 py-1.5 bg-white border border-gray-200 hover:border-purple-300 hover:bg-purple-50 text-gray-700 rounded-lg" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
