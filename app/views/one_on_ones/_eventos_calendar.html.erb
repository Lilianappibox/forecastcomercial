<%# Locals: eventos (Array de {titulo:, fecha:, invitados:}) %>
<% if eventos.blank? %>
  <p class="text-xs text-gray-400 mt-2">No se encontraron reuniones en tu calendario este mes.</p>
<% else %>
  <div class="mt-2 space-y-1 max-h-56 overflow-y-auto">
    <% eventos.each do |ev| %>
      <label class="flex items-start gap-2 text-xs border border-gray-200 rounded-lg px-2 py-1.5 cursor-pointer hover:bg-gray-50">
        <input type="checkbox" checked class="mt-0.5 calendar-evento-check"
          data-titulo="<%= ev[:titulo] %>" data-fecha="<%= ev[:fecha] %>" data-invitados="<%= ev[:invitados] %>">
        <span>
          <strong class="text-gray-700"><%= ev[:titulo] %></strong><br>
          <span class="text-gray-400"><%= ev[:fecha] %><%= " · #{ev[:invitados]}" if ev[:invitados].present? %></span>
        </span>
      </label>
    <% end %>
  </div>
  <button type="button" id="importar-eventos-btn" class="mt-3 text-xs px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium">Importar seleccionadas</button>
<% end %>
