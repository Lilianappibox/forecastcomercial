<% content_for :title, "Asignación de Metas" %>
<div class="max-w-6xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-800">🎯 Asignación de Metas</h1>
    <%= link_to "+ Asignar meta", new_goal_path, class: "px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90", style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
  </div>

  <%= form_with url: goals_path, method: :get, class: "flex items-end gap-3 mb-6" do %>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Año</label>
      <input type="number" name="year" value="<%= @year %>" class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-28">
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Mes</label>
      <select name="month" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
        <option value="">Todos</option>
        <% (1..12).each do |m| %>
          <option value="<%= m %>" <%= "selected" if @month == m %>><%= mes_nombre(m) %></option>
        <% end %>
      </select>
    </div>
    <button type="submit" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium">Filtrar</button>
  <% end %>

  <% if @goals.empty? %>
    <div class="bg-white rounded-xl border border-gray-100 p-10 text-center text-gray-400 text-sm">
      No hay metas asignadas para este período.
    </div>
  <% else %>
    <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="text-left px-4 py-3">KAM</th>
            <th class="text-left px-4 py-3">Mes</th>
            <th class="text-right px-4 py-3">Meta GMV</th>
            <th class="text-right px-4 py-3">Income esperado</th>
            <th class="text-right px-4 py-3">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @goals.each do |goal| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-800"><%= goal.user.nombre %></td>
              <td class="px-4 py-3 text-gray-600"><%= mes_nombre(goal.month) %> <%= goal.year %></td>
              <td class="px-4 py-3 text-right"><%= fmt(goal.gmv_meta) %></td>
              <td class="px-4 py-3 text-right text-gray-600"><%= fmt(goal.income_esperado) %></td>
              <td class="px-4 py-3 text-right space-x-3 whitespace-nowrap">
                <%= link_to "📊 Seguimiento", goal_path(goal), class: "text-purple-600 hover:underline" %>
                <%= link_to "🖼️ Imagen", image_goal_path(goal), class: "text-purple-600 hover:underline" %>
                <%= link_to "✏️ Editar", edit_goal_path(goal), class: "text-blue-600 hover:underline" %>
                <%= button_to "🗑️", goal, method: :delete,
                    data: { turbo_confirm: "¿Eliminar esta meta?" },
                    class: "text-red-500 hover:underline border-0 bg-transparent cursor-pointer inline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
