<%# Locals: user, permisos_configurables %>
<%= form_with model: user, class: "space-y-6" do |f| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 text-sm">
      <p class="font-semibold mb-2">Por favor corrige los siguientes errores:</p>
      <ul class="list-disc list-inside space-y-1">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Nombre *</label>
      <%= f.text_field :nombre, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Email *</label>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">
        Contraseña <%= user.new_record? ? "*" : "(dejar en blanco para no cambiar)" %>
      </label>
      <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Confirmar contraseña</label>
      <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Rol *</label>
      <%= f.select :rol, User::ROLES.values, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Cargo</label>
      <%= f.text_field :cargo, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 mb-1 block">Celular</label>
      <%= f.text_field :celular, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
    </div>
    <div class="flex items-center gap-3 pt-4">
      <label class="text-xs font-semibold text-gray-600">Estado:</label>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box :activo, class: "accent-green-600 w-4 h-4" %>
        <span class="text-sm text-gray-700">Usuario activo</span>
      </label>
    </div>
  </div>

  <div class="bg-gray-50 rounded-xl border border-gray-200 p-4">
    <h3 class="font-semibold text-gray-700 mb-3 text-sm">🔑 Permisos adicionales</h3>
    <p class="text-xs text-gray-500 mb-3">Los administradores siempre tienen acceso completo. Estos permisos aplican para KAM.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      <% permisos_configurables.each do |p| %>
        <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-white">
          <input type="checkbox" name="user[permisos_custom][<%= p[:id] %>]" value="true"
            <%= "checked" if [true, "true"].include?(user.permisos_custom&.dig(p[:id])) %>
            class="accent-purple-600">
          <span class="text-xs text-gray-700"><%= p[:label] %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit user.new_record? ? "Crear usuario" : "Actualizar usuario",
        class: "px-6 py-2 text-white rounded-lg text-sm font-semibold cursor-pointer hover:opacity-90",
        style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
    <%= link_to "Cancelar", users_path, class: "px-6 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" %>
  </div>
<% end %>
