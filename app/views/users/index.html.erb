<% content_for :title, "Usuarios" %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-800">👥 Usuarios</h1>
    <%= link_to "➕ Nuevo usuario", new_user_path, class: "px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90", style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
  </div>

  <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
        <tr>
          <th class="text-left px-4 py-3">Nombre</th>
          <th class="text-left px-4 py-3">Email</th>
          <th class="text-left px-4 py-3">Rol</th>
          <th class="text-left px-4 py-3">Estado</th>
          <th class="text-right px-4 py-3">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-xs"><%= user.initial %></div>
                <div>
                  <p class="font-medium text-gray-800"><%= user.nombre %></p>
                  <% if user.cargo.present? %><p class="text-xs text-gray-400"><%= user.cargo %></p><% end %>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= user.email %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium <%= user.admin? ? "bg-fuchsia-100 text-fuchsia-700" : "bg-purple-100 text-purple-700" %>">
                <%= user.admin? ? "🛡️" : "💼" %> <%= user.rol %>
              </span>
            </td>
            <td class="px-4 py-3">
              <%= user.activo? ? "✅ Activo" : "❌ Inactivo" %>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "✏️", edit_user_path(user), class: "text-gray-400 hover:text-blue-600 text-sm p-1 rounded hover:bg-blue-50" %>
                <% unless user.id == current_user.id %>
                  <%= button_to "🗑️", user, method: :delete,
                      data: { turbo_confirm: "¿Eliminar a #{user.nombre}?" },
                      class: "text-gray-400 hover:text-red-600 text-sm p-1 rounded hover:bg-red-50 border-0 bg-transparent cursor-pointer" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
