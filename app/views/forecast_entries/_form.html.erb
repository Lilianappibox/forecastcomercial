<%# Locals: entry, goal %>
<%= form_with model: entry, url: (entry.new_record? ? forecast_entries_path : forecast_entry_path(entry)), class: "space-y-6", id: "forecast-form" do |f| %>
  <% if entry.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 text-sm">
      <p class="font-semibold mb-2">Por favor corrige los siguientes errores:</p>
      <ul class="list-disc list-inside space-y-1">
        <% entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :user_id %>
  <%= f.hidden_field :year %>
  <%= f.hidden_field :month %>

  <div class="bg-purple-50 border border-purple-100 rounded-xl p-4 text-sm text-purple-800">
    <%= entry.user.nombre %> — <%= mes_nombre(entry.month) %> <%= entry.year %>
    <% if goal %>
      · Meta GMV: <strong><%= fmt(goal.gmv_meta) %></strong>
    <% else %>
      · <span class="text-purple-500">No hay meta asignada para este mes todavía.</span>
    <% end %>
  </div>

  <div>
    <label class="text-xs font-semibold text-gray-600 mb-1 block">GMV real *</label>
    <%= f.number_field :gmv_real, step: "1", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <% if goal&.okr_gestion.present? || goal&.okr_asistencia.present? %>
    <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 text-xs text-blue-700">
      El avance de tus OKR (gestión y asistencia) se diligencia en tu <%= link_to "1:1 de #{mes_nombre(entry.month)}", entrar_one_on_ones_path(year: entry.year, month: entry.month, user_id: entry.user_id), class: "underline font-semibold" %>.
    </div>
  <% end %>

  <div>
    <label class="text-xs font-semibold text-gray-600 mb-1 block">Notas</label>
    <%= f.text_area :notas, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit entry.new_record? ? "Guardar forecast" : "Actualizar forecast",
        class: "px-6 py-2 text-white rounded-lg text-sm font-semibold cursor-pointer hover:opacity-90",
        style: "background: linear-gradient(135deg, #5B17A8, #C026D3)" %>
    <%= link_to "Cancelar", forecast_entries_path, class: "px-6 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium" %>
  </div>
<% end %>
