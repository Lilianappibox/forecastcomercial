<% content_for :title, "Clientes" %>
<% kam_actual = @kams.find { |k| k.id == @kam_id } %>
<div class="max-w-5xl mx-auto px-4 py-6">
  <h1 class="text-xl font-bold text-gray-800 mb-6">🤝 Clientes</h1>

  <% if current_user.admin? %>
    <%= form_with url: clientes_path, method: :get, class: "flex items-end gap-3 mb-6" do %>
      <div>
        <label class="text-xs font-semibold text-gray-600 mb-1 block">KAM</label>
        <select name="kam_id" onchange="this.form.requestSubmit()" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
          <% @kams.each do |k| %>
            <option value="<%= k.id %>" <%= "selected" if k.id == @kam_id %>><%= k.nombre %></option>
          <% end %>
        </select>
      </div>
      <button type="submit" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium">Ver</button>
    <% end %>
  <% end %>

  <% if @puede_subir %>
    <div class="bg-white shadow-sm rounded-xl border border-gray-100 p-4 mb-6">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">📤 Subir archivo mensual</h3>
      <%= form_with url: clientes_path, method: :post, multipart: true, class: "flex items-end gap-3" do %>
        <% if current_user.admin? %>
          <%= hidden_field_tag :kam_id, @kam_id %>
        <% end %>
        <div class="flex-1">
          <input type="file" name="file" accept=".xlsx" required
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:bg-teal-50 file:text-teal-700 file:text-xs file:font-semibold">
        </div>
        <button type="submit" class="px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90" style="background: linear-gradient(135deg, #0d9488, #2dd4bf);">Subir</button>
      <% end %>
      <p class="text-xs text-gray-400 mt-2">Archivo .xlsx con columnas Month, GroupByDetail, GMV y Service Income. El mes se detecta automáticamente; si ya existe un archivo de ese mes, se reemplaza.</p>
    </div>
  <% end %>

  <% if @archivos.blank? %>
    <div class="bg-white rounded-xl border border-gray-100 p-10 text-center text-gray-400 text-sm">
      <%= kam_actual ? "#{kam_actual.nombre} todavía no ha subido ningún archivo." : "Selecciona un KAM para ver su historial." %>
    </div>
  <% else %>
    <div class="bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="text-left px-4 py-3">Mes</th>
            <th class="text-left px-4 py-3">Archivo</th>
            <th class="text-right px-4 py-3"># Clientes</th>
            <th class="text-right px-4 py-3">GMV total</th>
            <th class="text-right px-4 py-3">Utilidad total</th>
            <th class="text-right px-4 py-3">% Utilidad</th>
            <th class="text-right px-4 py-3">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @archivos.each do |archivo| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-800"><%= mes_nombre(archivo.month) %> <%= archivo.year %></td>
              <td class="px-4 py-3 text-gray-500 text-xs"><%= archivo.nombre_archivo %></td>
              <td class="px-4 py-3 text-right text-gray-600"><%= archivo.filas.size %></td>
              <td class="px-4 py-3 text-right text-gray-600"><%= fmt(archivo.total_gmv) %></td>
              <td class="px-4 py-3 text-right text-gray-600"><%= fmt(archivo.total_utilidad) %></td>
              <td class="px-4 py-3 text-right">
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= pct_badge_class(archivo.pct_utilidad_total) %>"><%= fmt_pct(archivo.pct_utilidad_total) %></span>
              </td>
              <td class="px-4 py-3 text-right space-x-2 whitespace-nowrap">
                <%= link_to "Ver detalle", cliente_path(archivo), class: "text-blue-600 hover:underline text-xs" %>
                <% if @puede_subir %>
                  <%= button_to "🗑️", cliente_path(archivo), method: :delete,
                      data: { turbo_confirm: "¿Eliminar el archivo de #{mes_nombre(archivo.month)} #{archivo.year}?" },
                      class: "text-red-500 hover:underline border-0 bg-transparent cursor-pointer inline text-xs" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
